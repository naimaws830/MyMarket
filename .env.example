# Copy this file to .env and fill in what you need.
# .env is gitignored. Never commit it. Never paste a key into a chat.

# ---------------------------------------------------------------------------
# LLM explainer (OPTIONAL)
# ---------------------------------------------------------------------------
# MyMarket does not need an LLM key. When it runs as an MCP server inside a
# chat host such as Claude Desktop, the host model writes the plain language
# sentences from the grounded facts each tool returns. That is the default and
# it keeps the server from inventing numbers.
#
# Set these only if you want the server itself to write prose, for example in
# the headless scripts/daily_refresh.py job. Any OpenAI compatible endpoint
# works. If LLM_API_KEY is empty, a deterministic template is used instead.
#
# EXPLAIN_MODE options:
#   host     return grounded facts, let the chat host narrate   (default)
#   llm      call the endpoint below, fall back to template on failure
#   template deterministic sentences only, never call out
EXPLAIN_MODE=host

# Moonshot / Kimi
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL=kimi-k2-0905-preview

# Groq
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Ollama, fully local, no key needed
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b

LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---------------------------------------------------------------------------
# Pipeline knobs (OPTIONAL, defaults shown)
# ---------------------------------------------------------------------------
# Label horizon in days and the threshold multiplier from PRD 6.4.
MYMARKET_HORIZON_DAYS=14
MYMARKET_THETA_K=0.5

# Minimum confidence before the model stops abstaining.
MYMARKET_MIN_CONFIDENCE=0.55
